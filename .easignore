# EAS Build archive filter (replaces .gitignore for `eas build`, so the .gitignore rules are repeated here).
# The archive is the whole monorepo because apps/mobile imports the @techrat/* packages and installs from the root
# package-lock.json. Everything below is not needed to build the Android app and only slows the upload down.
# apps/web and apps/desktop stay: they are npm workspaces, and `npm ci` fails when a workspace listed in the root
# package.json is missing from the archive.

# --- same as .gitignore
node_modules/
.next/
out/
dist/
coverage/
*.tsbuildinfo
.expo/
playwright-report/
test-results/
apps/desktop/src-tauri/target/
.env
.env.*
!.env.example
!.env.production.example
.DS_Store
.idea/
.vs/
.vscode/
.dev/
__pycache__/
bin/
obj/

# --- not needed to build the app
backend/
e2e/
docs/
deploy/
docker/
scripts/
.github/
