{
  "name": "techrat",
  "private": true,
  "version": "0.1.0",
  "description": "TechRat \u2014 gamified learning platform for tech careers",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/desktop",
    "apps/mobile"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @techrat/web",
    "build:web": "npm run build -w @techrat/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "playwright test",
    "generate:api": "bash scripts/generate-api-client.sh"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}