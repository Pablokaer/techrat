# Copy to .env (never commit .env). All values are optional for local development.
POSTGRES_PASSWORD=change-me
# Bootstrap an admin account on first start (leave empty to skip)
ADMIN_EMAIL=admin@techrat.local
ADMIN_PASSWORD=ChangeMe123
ASPNETCORE_ENVIRONMENT=Development
# Optional OpenTelemetry collector (e.g. http://otel-collector:4317) — can forward to Azure Monitor / Application Insights
OTEL_EXPORTER_OTLP_ENDPOINT=
# Mobile
EXPO_PUBLIC_API_URL=http://localhost:5080
# Desktop build
NEXT_PUBLIC_API_URL=http://localhost:5080
# Path to an extra CA certificate for docker builds behind TLS-inspecting proxies (optional)
EXTRA_CA_CERT=
# Auth endpoint rate limit per IP per minute (raise for E2E runs)
AUTH_RATE_LIMIT_PER_MINUTE=20
