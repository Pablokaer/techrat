# Copy to .env (never commit .env). All values are optional for local development.
POSTGRES_PASSWORD=change-me
# Bootstrap an admin account on first start (leave empty to skip)
ADMIN_EMAIL=admin@techrat.local
# Choose your own passphrase: a common password (ChangeMe123, Password1...) is refused and no admin is created.
ADMIN_PASSWORD=
ASPNETCORE_ENVIRONMENT=Development
# Optional: encrypts the login keys stored in PostgreSQL. `deploy/new-dataprotection-cert.sh .env` fills these two in.
DATAPROTECTION_CERT_BASE64=
DATAPROTECTION_CERT_PASSWORD=
# Optional OpenTelemetry collector (e.g. http://otel-collector:4317) — can forward to Azure Monitor / Application Insights
OTEL_EXPORTER_OTLP_ENDPOINT=
# Email (SMTP). Leave empty locally to use Mailpit (http://localhost:8025). See docs/email.md.
# Resend:   SMTP_HOST=smtp.resend.com  SMTP_PORT=587 SMTP_SECURITY=StartTls  SMTP_USERNAME=resend  SMTP_PASSWORD=<API key>
# SES:      SMTP_HOST=email-smtp.<region>.amazonaws.com  SMTP_PORT=587 SMTP_SECURITY=StartTls  SMTP_USERNAME/PASSWORD=<SMTP credentials>
# Brevo:    SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587 SMTP_SECURITY=StartTls  SMTP_USERNAME=<login>  SMTP_PASSWORD=<SMTP key>
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=TechRat <no-reply@yourdomain.com>
SMTP_REPLY_TO=
# Mobile
EXPO_PUBLIC_API_URL=http://localhost:5080
# Desktop build
NEXT_PUBLIC_API_URL=http://localhost:5080
# Path to an extra CA certificate for docker builds behind TLS-inspecting proxies (optional)
EXTRA_CA_CERT=
# Auth endpoint rate limit per IP per minute (raise for E2E runs)
AUTH_RATE_LIMIT_PER_MINUTE=20
