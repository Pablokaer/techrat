# Production settings for docker-compose.prod.yml. Copy to .env ON THE SERVER only (never commit it).
# Generate secrets with: openssl rand -base64 32
PUBLIC_WEB_URL=https://techrat.io
POSTGRES_PASSWORD=
# Admin account bootstrapped on first start (change the password after the first sign-in).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Email (see docs/email.md). Resend example:
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM=TechRat <no-reply@techrat.io>
SMTP_REPLY_TO=
# Optional
OPENAPI_UI=false
AUTH_RATE_LIMIT_PER_MINUTE=20
OTEL_EXPORTER_OTLP_ENDPOINT=
WEB_PORT=3000
API_PORT=5080
