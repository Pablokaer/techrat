{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TechRat",
  "version": "0.1.0",
  "identifier": "dev.techrat.desktop",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:desktop -w @techrat/web",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "TechRat — Learn. Practice. Level Up.",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:5080 ws://localhost:5080 https://*.techrat.dev wss://*.techrat.dev ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
