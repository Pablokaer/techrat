{
  "expo": {
    "name": "TechRat",
    "slug": "techrat",
    "scheme": "techrat",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "dev.techrat.app",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.techrat.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-web-browser"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
